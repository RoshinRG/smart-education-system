# Server Port
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_education

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# JWT Expiry
JWT_EXPIRES_IN=7d

# OpenAI (optional — for AI tutor)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
